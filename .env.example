# Meta Model API Configuration
# Base URL for Meta Model API (e.g. official endpoint https://api.meta.ai/v1 or OpenAI-compatible endpoint)
META_BASE_URL=https://api.meta.ai/v1

# Authentication Bearer Token for Meta Model API
META_API_KEY=your_meta_api_key_here

# Meta model identifier (e.g. llama-3.3-70b-instruct or your deployed model ID)
META_MODEL=muse-spark-1.3
